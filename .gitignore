**/.DS_Store
**/.env
**/.env.*
**/.venv/
**/venv/
**/*.log
**/*.sqlite*
**/*.db
**/*.sql
**/*.sql.gz
**/*.tar*
**/*.zip
**/*.pem
**/*.key
**/*access*.txt
**/*password*.txt
**/*ed25519*
**/fakturor-key

