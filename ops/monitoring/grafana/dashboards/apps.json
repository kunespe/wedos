          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "MAVACOM loguje v beznem formatu, takze ma stavove tridy. ZUBZI loguje JSON bez udaju o pacientech, proto je u nej jen celkovy pocet."
