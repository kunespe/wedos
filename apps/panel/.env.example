# MySQL connection for the panel. On the server: a dedicated DB `servero_panel` and user in the CloudPanel MySQL.
# Required; the app refuses to start without it.
DATABASE_URL=mysql://servero:CHANGE_ME@127.0.0.1:3306/servero_panel

# Public URL of the panel, used in invite links and e-mails (adapter-node 6 no longer reads it).
# Required. Local dev: http://localhost:5190
ORIGIN=https://panel.serveros.cz

# Storefront origins that may call /api/orders, /api/domain-check and /stav.json (CORS), comma-separated.
# During the move from servero.cz both are listed: https://serveros.cz,https://servero.cz
# Required. Local dev: http://localhost:4410
PUBLIC_WEB_ORIGIN=https://serveros.cz

# Unix socket of the privileged broker (dashboard/broker.py). Empty disables server operations in the admin.
BROKER_SOCKET=/run/vw-dashboard/broker.sock

# Prometheus HTTP API, used for uptime/SSL/latency of customer services. Empty hides metrics.
PROMETHEUS_URL=http://127.0.0.1:9090

# File the panel writes with blackbox probe targets (file_sd format) for Grafana Alloy. Empty disables writing.
PROBES_FILE=/var/lib/servero-panel/probes.json

# Public Grafana URL, linked from the admin Monitoring page. Empty hides the link.
GRAFANA_URL=https://monitor.serveros.cz

# Base URL of the CloudPanel admin on the local node, used by the admin "Otevřít CloudPanel" button
# (the broker issues a one-time token and the panel redirects to <CLOUDPANEL_URL>/autologin?token=...).
# Get it from the CloudPanel install (https://<server IP>:8443). Empty hides the CloudPanel button.
CLOUDPANEL_URL=

# SMTP for outgoing mail, nodemailer URL format smtp://user:pass@host:587 (STARTTLS).
# Production: the info@serveros.cz mailbox on Váš-hosting, e.g.
# smtp://info%40serveros.cz:PASSWORD@mcg07.vas-server.cz:587 (set with ops/set-mail-password.sh).
# Hetzner blocks outbound 25 and 465 here; 587 works. Empty prints e-mails to the log instead of sending.
SMTP_URL=

# Sender of all automated e-mails (invites, payment requests, notifications). Must be the SMTP mailbox
# above or allowed to send through it (SPF/DKIM on serveros.cz).
MAIL_FROM=SERVEROS <info@serveros.cz>
# Reply-To on automated e-mails, so customer replies reach the team inbox. Empty: no Reply-To header.
MAIL_REPLY_TO=info@serveros.cz

# WEDOS WAPI (domain registrar API), used by the admin "WEDOS" buttons on /admin/domeny.
# Login e-mail of the WEDOS customer account. Empty disables the integration and hides its buttons.
WEDOS_WAPI_USER=
# WAPI password (NOT the account password): WEDOS admin > WAPI > Nastavení, set it there. Secret, never commit.
# The server IP 2.31.25.249 must be whitelisted in WEDOS admin > WAPI > Povolené IP adresy. Missing: integration off.
WEDOS_WAPI_PASSWORD=
# 1 = changes (registration, renewal, transfer, contacts) are sent for real and cost credit.
# 0 or empty (default) = WAPI test mode: WEDOS only validates the request, nothing changes.
WEDOS_WAPI_LIVE=0
# NSSET handle used for new .cz registrations. Empty: the nameservers from WEDOS_DNS are sent instead.
WEDOS_NSSET=
# Comma-separated nameservers for new registrations without an NSSET, e.g. ns.wedos.net,ns.wedos.eu.
# Empty: WEDOS uses its default nameservers.
WEDOS_DNS=
