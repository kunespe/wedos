# MySQL connection for the panel. On the server: a dedicated DB `servero_panel` and user in the CloudPanel MySQL.
# Required; the app refuses to start without it.
DATABASE_URL=mysql://servero:CHANGE_ME@127.0.0.1:3306/servero_panel

# Public URL of the panel, used in invite links and e-mails (adapter-node 6 no longer reads it).
# Required. Local dev: http://localhost:5190
ORIGIN=https://panel.servero.cz

# Origin of the servero.cz storefront that may POST /api/orders (CORS).
# Required. Local dev: http://localhost:4410
PUBLIC_WEB_ORIGIN=https://servero.cz

# Unix socket of the privileged broker (dashboard/broker.py). Empty disables server operations in the admin.
BROKER_SOCKET=/run/vw-dashboard/broker.sock

# Prometheus HTTP API, used for uptime/SSL/latency of customer services. Empty hides metrics.
PROMETHEUS_URL=http://127.0.0.1:9090

# File the panel writes with blackbox probe targets (file_sd format) for Grafana Alloy. Empty disables writing.
PROBES_FILE=/var/lib/servero-panel/probes.json

# Public Grafana URL, linked from the admin Monitoring page. Empty hides the link.
GRAFANA_URL=https://monitor.servero.cz

# Base URL of the CloudPanel admin on the local node, used by the admin "Otevřít CloudPanel" button
# (the broker issues a one-time token and the panel redirects to <CLOUDPANEL_URL>/autologin?token=...).
# Get it from the CloudPanel install (https://<server IP>:8443). Empty hides the CloudPanel button.
CLOUDPANEL_URL=

# SMTP for outgoing mail, nodemailer URL format smtp(s)://user:pass@host:port.
# Obtain from the mail provider (e.g. Brevo, Seznam). Empty prints e-mails to the log instead of sending.
SMTP_URL=

# Sender address for panel e-mails. Must be allowed by the SMTP provider (SPF/DKIM on servero.cz).
MAIL_FROM=SERVERO <info@servero.cz>

# Team inbox that receives a notification for each new order. Empty disables the notification.
ORDER_NOTIFY_EMAIL=info@servero.cz

# Cloudflare Turnstile secret for the public order form. Obtain in the Cloudflare dashboard.
# Empty skips the captcha check (honeypot and rate limit still apply).
TURNSTILE_SECRET=

# adapter-node runtime settings for running behind nginx (not read by the app code directly).
# Client IP for rate limits and audit comes from this header; must match what nginx sets.
ADDRESS_HEADER=X-Forwarded-For
# adapter-node derives the request origin (used by the CSRF check) from this header; without it
# it assumes https. nginx sends X-Forwarded-Proto: https. Local `pnpm dev` ignores it.
PROTOCOL_HEADER=x-forwarded-proto
# Number of trusted proxies in front of the app (nginx only = 1).
XFF_DEPTH=1
# Loopback port the systemd unit listens on; nginx proxies panel.servero.cz here.
PORT=3000
HOST=127.0.0.1

# --- Payment requests (zálohové výzvy k platbě). Tax invoices are still issued in Fakturor. ---
# Supplier details printed on payment requests. Fill in once the company form (s.r.o./OSVČ) is decided.
SUPPLIER_NAME=SERVERO
SUPPLIER_ICO=
# Empty while not a VAT payer.
SUPPLIER_DIC=
SUPPLIER_ADDRESS=Plzeň
# Business bank account for transfers (Czech format). Empty: requests show "účet doplníme" and no QR code.
PAYMENT_ACCOUNT=
# IBAN of the same account (CZ + 22 digits), used for the QR payment. Empty hides the QR code.
PAYMENT_IBAN=
# VAT added to requests: 0 while not a VAT payer, 21 once registered. Must be 0, 12 or 21.
VAT_RATE=0
# Days until a payment request is due (1-60).
PAYMENT_DUE_DAYS=14
