[Unit]
Description=Vytvorit web hosting dashboard
After=network.target vw-dashboard-broker.service
Requires=vw-dashboard-broker.service

[Service]
Type=simple
User=vw-dashboard
Group=vw-dashboard
WorkingDirectory=/opt/vw-dashboard
ExecStart=/opt/vw-dashboard/venv/bin/gunicorn --bind 127.0.0.1:8765 --workers 1 --threads 4 --timeout 330 app:app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/vw-dashboard-web
MemoryMax=256M
UMask=0077

[Install]
WantedBy=multi-user.target
